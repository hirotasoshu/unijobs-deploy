default_zone = "ru-central1-a"
project      = "unijobs"
github_owner = "<github-user-or-org>"

# Stable local context. Safe to keep in ignored terraform.tfvars for convenience.
# Do not put short-lived tokens here; export TF_VAR_yc_token before running Terraform.
yc_cloud_id  = "<yc-cloud-id>"
yc_folder_id = "<yc-folder-id>"

# Optional: if unset, Terraform pulls this public image and pushes it into the created YCR registry as bootstrap placeholder.
# bootstrap_backend_image_source = "traefik/whoami:latest"

# Optional: skip local placeholder image push and use an existing image instead.
# backend_image_url = "cr.yandex/<registry-id>/unijobs-backend:latest"
